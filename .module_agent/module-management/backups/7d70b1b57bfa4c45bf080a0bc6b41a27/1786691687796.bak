/** 构造一个骨架工具：调用时返回"尚未实现"错误，由后续模块替换真实实现。 */
export function buildSkeletonTool(meta: SkeletonToolMeta) {
  return defineTool({
    name: meta.name,
    description: meta.description,
    parameters: {},
    output: jsonToolOutput(),
    async execute() {
      return {
        status: 'error',
        error: `工具 ${meta.name} 尚未实现，将由后续模块移植实现。`,
      }
    },
  })
}
