import { mkdir, rm } from 'node:fs/promises'
import { readdir } from 'node:fs/promises'
import { join, relative } from 'node:path'
import { defineTool } from '@deepseek-ai/dsh-tools'
import type { JsonValue } from '@deepseek-ai/dsh-session'
import { directoryOfAgent, type SessionState } from '../lib/session_state.ts'
import {
  moduleAgentDir,
  AGENT_PROFILE_FILE,
  CURRENT_SPEC_FILE,
  CHANGE_HISTORY_FILE,
  EXECUTION_RESULTS_DIR,
  defaultAgentProfile,
  defaultCurrentSpec,
  INITIAL_CHANGE_HISTORY,
} from '../lib/constants.ts'
import {
  addModule,
  findModule,
  readModuleTree,
  readModuleTreeSync,
  removeModule,
  writeModuleTreeSync,
} from '../lib/module_tree.ts'
import { writeAgentProfile } from '../lib/agent_profile.ts'
import { readDefinitionSync } from '../lib/module_definition.ts'
import { removeModuleDesign } from '../lib/module_design.ts'
import { writeText } from '../lib/fs.ts'
import { jsonToolOutput } from '../lib/tool_output.ts'

export interface ModuleAgentAdminToolOptions {
  /** 会话模式注册表（用于校验调用者身份）。 */
  readonly sessionState: SessionState
  /** 项目根目录兜底（agent 会话 cwd 缺失时使用，允许显式 undefined）。 */
  readonly dataDir?: string | undefined
}

/** 创建或修改力牧的配置与数据文件。用于管理项目中的模块结构。 */
export function createModuleAgentAdminTool(options: ModuleAgentAdminToolOptions) {
  return defineTool({
    name: 'module_agent_admin',
    description: '创建或修改力牧的配置与数据文件。用于管理项目中的模块结构。',
    parameters: {
      action: {
        type: 'string',
        required: true,
        enum: ['create', 'update', 'delete', 'list_dirs', 'read_modules'],
        description: '操作类型：create 创建模块，update 修改模块，delete 删除模块（模块定义中无文件时才可删除），list_dirs 列出候选模块目录，read_modules 读取所有模块',
      },
      module_name: {
        type: 'string',
        description: '模块唯一标识名称（list_dirs 时无需提供）',
      },
      description: {
        type: 'string',
        description: '模块说明（create/update 时有效）',
      },
      agent_profile_content: {
        type: 'string',
        description: '智能体文本内容，定义角色、专长、代码规范',
      },
      initial_spec: {
        type: 'string',
        description: '初始功能说明（仅 create 时有效）',
      },
      ignore: {
        type: 'array',
        items: { type: 'string' },
        description: 'list_dirs：忽略目录名列表',
      },
    },
    output: jsonToolOutput(),
    async execute(args, exec) {
      const directory = directoryOfAgent(exec.agent, options.dataDir)
      const agentId = exec.agent?.id ?? ''
      const mode = options.sessionState.getAgentMode(agentId)
      const action = args.action

      const allowed = action === 'read_modules'
        ? mode === 'fengzhou' || mode === 'lishou'
        : mode === 'fengzhou'
      if (!allowed) {
        return {
          status: 'error',
          error: action === 'read_modules'
            ? 'module_agent_admin 的 read_modules 仅供风后或隶首调用。'
            : 'module_agent_admin 仅供风后调用。',
        }
      }

      if (action === 'read_modules') {
        const tree = await readModuleTree(directory)
        return { status: 'ok', modules: tree.modules as unknown as JsonValue[] }
      }

      if (action === 'list_dirs') {
        return handleListDirs(directory, args.ignore ?? ['.git', 'node_modules', '.module_agent', 'dist', 'build', '__pycache__'])
      }

      if (action === 'create') {
        return handleCreate(directory, args)
      }

      if (action === 'delete') {
        if (!args.module_name) {
          return { status: 'error', error: 'delete 操作需提供 module_name' }
        }
        return handleDelete(directory, args.module_name)
      }

      return handleUpdate(directory, args)
    },
  })
}

async function handleCreate(
  directory: string,
  args: { module_name?: string; description?: string; agent_profile_content?: string; initial_spec?: string },
) {
  const { description, agent_profile_content, initial_spec } = args
  const module_name = args.module_name

  if (!module_name) {
    return { status: 'error', error: 'create 操作需提供 module_name' }
  }

  const existingModule = await findModule(directory, module_name)
  if (existingModule) {
    return { status: 'error', error: `模块 '${module_name}' 已存在` }
  }

  // 创建 .module_agent/<module_name>/ 目录结构
  const agentDir = moduleAgentDir(directory, module_name)
  const resultsDir = join(agentDir, EXECUTION_RESULTS_DIR)
  await mkdir(agentDir, { recursive: true })
  await mkdir(resultsDir, { recursive: true })

  const profileContent = agent_profile_content || defaultAgentProfile(module_name)
  const specContent = initial_spec || defaultCurrentSpec(module_name)

  await writeText(join(agentDir, AGENT_PROFILE_FILE), profileContent)
  await writeText(join(agentDir, CURRENT_SPEC_FILE), specContent)
  await writeText(join(agentDir, CHANGE_HISTORY_FILE), INITIAL_CHANGE_HISTORY)

  addModule(directory, { name: module_name, description: description || '' })

  const paths = [
    join('.module_agent', module_name, AGENT_PROFILE_FILE),
    join('.module_agent', module_name, CURRENT_SPEC_FILE),
    join('.module_agent', module_name, CHANGE_HISTORY_FILE),
    join('.module_agent', module_name, EXECUTION_RESULTS_DIR) + '/',
  ]

  return { status: 'created', paths }
}

async function handleUpdate(
  directory: string,
  args: { module_name?: string; description?: string; agent_profile_content?: string },
) {
  const { description, agent_profile_content } = args
  const module_name = args.module_name

  if (!module_name) {
    return { status: 'error', error: 'update 操作需提供 module_name' }
  }

  const existingModule = await findModule(directory, module_name)
  if (!existingModule) {
    return { status: 'error', error: `模块 '${module_name}' 不存在，请先创建` }
  }

  const changedFiles: string[] = []

  if (description !== undefined) {
    const tree = readModuleTreeSync(directory)
    const modEntry = tree.modules.find((m) => m.name === module_name)
    if (modEntry) modEntry.description = description
    writeModuleTreeSync(directory, tree)
    changedFiles.push('.module_agent/module_tree.json')
  }

  if (agent_profile_content !== undefined) {
    await writeAgentProfile(directory, module_name, agent_profile_content)
    changedFiles.push(join('.module_agent', module_name, AGENT_PROFILE_FILE))
  }

  return { status: 'updated', changed_files: changedFiles }
}

async function handleDelete(directory: string, moduleName: string) {
  const existingModule = await findModule(directory, moduleName)
  if (!existingModule) {
    return { status: 'error', error: `模块 '${moduleName}' 不存在` }
  }

  const def = readDefinitionSync(directory, moduleName)
  if (def.files.length > 0) {
    return {
      status: 'error',
      error: `模块 '${moduleName}' 的模块定义中仍有 ${def.files.length} 个文件，无法删除。请先通过 module_agent_updater(action="move_definition") 将文件移至其他模块或通过 update_definition 移除文件条目。`,
      files: def.files.map((f) => f.path),
    }
  }

  removeModule(directory, moduleName)
  await removeModuleDesign(directory, moduleName)
  await rm(moduleAgentDir(directory, moduleName), { recursive: true, force: true })

  return {
    status: 'deleted',
    removed: [
      '.module_agent/module_tree.json 中的模块条目',
      'module_design.json 中的模块设计条目',
      join('.module_agent', moduleName) + '/',
    ],
  }
}

async function handleListDirs(directory: string, ignore: string[]) {
  const ignoreSet = new Set(ignore)
  // 收集所有已分配的文件路径
  const tree = await readModuleTree(directory)
  const assignedFiles = new Set<string>()
  for (const m of tree.modules) {
    try {
      const def = readDefinitionSync(directory, m.name)
      for (const f of def.files) {
        assignedFiles.add(f.path)
      }
    } catch {
      // module_definition 不存在 → 跳过
    }
  }

  const candidateDirs = new Set<string>()

  async function walk(dir: string) {
    const entries = await readdir(dir, { withFileTypes: true })
    for (const entry of entries) {
      if (!entry.isDirectory()) continue
      if (ignoreSet.has(entry.name)) continue
      if (entry.name.startsWith('.')) continue

      const fullPath = join(dir, entry.name)
      await walk(fullPath)
    }
    // 检查当前目录下是否有未分配的文件
    for (const entry of entries) {
      if (!entry.isFile()) continue
      const relPath = relative(directory, join(dir, entry.name)).replace(/\\/g, '/')
      if (!assignedFiles.has(relPath)) {
        candidateDirs.add(relative(directory, dir).replace(/\\/g, '/'))
        break
      }
    }
  }

  await walk(directory)

  // root level files → path = "."
  const rootEntries = await readdir(directory, { withFileTypes: true })
  if (rootEntries.some((e) => e.isFile())) {
    const relPath = relative(directory, directory).replace(/\\/g, '/') || '.'
    candidateDirs.add(relPath)
  }

  return { status: 'ok', candidates: [...candidateDirs] }
}
