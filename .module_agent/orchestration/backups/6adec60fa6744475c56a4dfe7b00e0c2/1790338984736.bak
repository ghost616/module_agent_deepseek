/**
 * 针对 src/tools/module_agent_executor.ts 本次变更的测试：
 * 1) recoverAgentMode 三级链：内存 descriptor → 冷会话 sessionPersistence handle
 *    （SessionHandleReadResult = { eventState, events }，按 inheritedEventCount 截断）
 *    → 文件兜底 restoreMode（仅框架子代理模式）。
 * 2) handlePing：冷会话身份恢复不再抛错；恢复成功 setAgentMode + persistMode；仍无法识别返回 error。
 * 3) isValidReusableSession：经 recoverAgentMode（含文件兜底）恢复角色后命中期望角色才复用。
 *
 * 说明：既有 executor-ping.test.ts 的冷会话 mock 已改为返回 { eventState, events } 形状。
 */
import { describe, it, expect, vi } from 'vitest'
import { mkdtemp, rm, writeFile, mkdir } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import { join } from 'node:path'

vi.mock('@deepseek-ai/dsh-tools', () => ({
  defineTool: (def: unknown) => def,
}))
vi.mock('@deepseek-ai/dsh-session', () => ({
  SessionId: (id: string) => id,
}))
vi.mock('@deepseek-ai/schemastery', () => ({
  default: {
    object: () => ({}),
    string: () => ({ default: () => ({}), optional: () => ({}) }),
  },
}))
vi.mock('@deepseek-ai/dsh-llm', () => ({
  createUserMessage: (msg: unknown) => msg,
}))

import { createModuleAgentExecutorTool } from '../../src/tools/module_agent_executor.ts'
import { SessionState, persistMode, restoreMode } from '../../src/lib/session_state.ts'
import { savePlan, markPlanComplete } from '../../src/lib/development_plan.ts'
import { storePlanConfirmation, getLatestCode, verificationCode } from '../../src/tools/verification_code.ts'

const CALLER = 'caller-fz'
const WS = 'ws1'
const PROVIDER = 'prov-x'
const MODEL = 'model-x'

async function tempDir(): Promise<string> {
  return (await mkdtemp(join(tmpdir(), 'ma-recover-'))).replace(/\\/g, '/')
}

async function writeJson(path: string, data: unknown): Promise<void> {
  await mkdir(join(path.split('/').slice(0, -1).join('/')), { recursive: true })
  await writeFile(path, JSON.stringify(data), 'utf-8')
}

interface DescriptorResult {
  events: unknown[]
  inheritedEventCount: number
}

/** 构造带 seed 前缀 + continuable descriptor 事件的会话事件流。 */
function descriptorEvents(mode: string | undefined, inheritedEventCount = 0): DescriptorResult {
  const events: unknown[] = []
  for (let i = 0; i < inheritedEventCount; i++) {
    events.push({ type: 'user/message', seq: i + 1, time: 0, data: { content: [{ type: 'text', text: `seed-${i}` }] } })
  }
  events.push({
    type: 'subagent/descriptor',
    seq: events.length + 1,
    time: 0,
    data: {
      version: 3,
      mode: 'continuable',
      provider: 'module-agent:test',
      label: '测试子智能体',
      persona: mode === undefined ? '普通 persona，无身份标记' : `module-agent:role=${mode}\n\n## 执行流程指令`,
    },
  })
  return { events, inheritedEventCount }
}

/** one-shot descriptor：foldSubagentDescriptor 返回 mode='one-shot'，应判无法识别。 */
function oneShotEvents(): DescriptorResult {
  return {
    events: [
      {
        type: 'subagent/descriptor',
        seq: 1,
        time: 0,
        data: { version: 3, mode: 'one-shot', provider: 'module-agent:test', label: '一次性任务' },
      },
    ],
    inheritedEventCount: 0,
  }
}

interface RuntimeOptions {
  sessionId: string
  /** 内存 agent 的 descriptor（经 ctx.agents 暴露，供 recoverAgentMode 第一级使用）。 */
  inMemory?: { mode: string | undefined; inheritedEventCount?: number } | 'one-shot'
  /** 冷会话 handle 返回（{ eventState, events } 由 runtime 包装）；'throw' 模拟 open 失败。 */
  cold?: DescriptorResult | 'throw'
  /** 文件兜底：写入 session_modes.json 的持久化角色。 */
  persisted?: string
  /** 复用校验相关：绑定/归属/计划等。 */
  bindings?: Record<string, Record<string, string>>
  seedWorkspaces?: Record<string, string>
  modules?: string[]
  moduleSessions?: Record<string, string[]>
  lizhuSessions?: string[]
  children?: string[]
  newChildId?: string
  modelConfig?: Record<string, { providerID: string; modelID: string }>
}

interface Runtime {
  dir: string
  workspaceDir: string
  state: SessionState
  followupTexts: string[]
  run: (args: Record<string, unknown>) => Promise<Record<string, unknown>>
}

async function makeRuntime(opts: RuntimeOptions): Promise<Runtime> {
  const dir = await tempDir()
  const followupTexts: string[] = []

  await writeJson(`${dir}/.module_agent/session_workspaces.json`, { [CALLER]: WS, ...(opts.seedWorkspaces ?? {}) })
  const wsDir = `${dir}/.module_agent/.workspaces/${WS}`
  await writeJson(`${wsDir}/session_bindings.json`, {
    gaotao: opts.bindings?.gaotao ?? {},
    limu: opts.bindings?.limu ?? {},
    lizhu: opts.bindings?.lizhu ?? {},
    lizhu_fengzhou: opts.bindings?.lizhu_fengzhou ?? {},
    kui: opts.bindings?.kui ?? {},
  })
  await writeJson(`${wsDir}/module_sessions.json`, opts.moduleSessions ?? {})
  await writeJson(`${wsDir}/lizhu_sessions.json`, opts.lizhuSessions ?? [])
  if (opts.modelConfig) await writeJson(`${wsDir}/agent_model_config.json`, opts.modelConfig)
  await writeJson(`${dir}/.module_agent/module_tree.json`, { modules: (opts.modules ?? []).map(name => ({ name })) })

  if (opts.persisted !== undefined) persistMode(dir, opts.sessionId, opts.persisted as never)

  const state = new SessionState()
  state.setAgentMode(CALLER, 'fengzhou')

  const children = (opts.children ?? []).map(id => ({ kind: 'child', id }))

  const ctx: any = {
    sessions: { get: () => ({ id: 'alive' }) },
    agents: {
      get: () => {
        if (!opts.inMemory) return undefined
        if (opts.inMemory === 'one-shot') {
          const { events, inheritedEventCount } = oneShotEvents()
          return { session: { ownEvents: () => events.slice(inheritedEventCount) } }
        }
        const { events, inheritedEventCount } = descriptorEvents(opts.inMemory.mode, opts.inMemory.inheritedEventCount ?? 0)
        return { session: { ownEvents: () => events.slice(inheritedEventCount) } }
      },
    },
    get: (key: string) => {
      if (key === 'sessionPersistence' && opts.cold) {
        if (opts.cold === 'throw') {
          return { stat: async () => ({}), open: async () => { throw new Error('session missing') } }
        }
        const { events, inheritedEventCount } = opts.cold
        return {
          stat: async () => ({}),
          open: async () => ({
            id: opts.sessionId,
            header: {},
            inheritedEventCount,
            // 真实 SessionHandleReadResult 形状（历史 mock 误返回事件数组，掩盖 bug）。
            read: async () => ({ eventState: 'shared', events }),
            close: async () => {},
          }),
        }
      }
      return undefined
    },
    subagents: {
      startContinuable: async () => ({ childId: opts.newChildId ?? 'unused-child' }),
      [Symbol.for('dsh.subagent.deliverPrompt')]: async (_p: unknown, _c: unknown, messages: unknown[]) => {
        followupTexts.push((messages as Array<{ type: string; text: string }>)[0]?.text ?? '')
      },
      listChildren: async () => children,
    },
    logger: { info: () => {}, warn: () => {} },
  }

  const tool = createModuleAgentExecutorTool({
    ctx,
    sessionState: state,
    catalog: {
      listProviders: async () => [{ id: PROVIDER, name: PROVIDER }],
      listModels: async () => [{ id: MODEL, name: MODEL }],
    },
    dataDir: dir,
    subagentProvider: 'spawn',
  })

  const caller = { id: CALLER, session: { header: { cwd: dir } } }
  const run = async (args: Record<string, unknown>): Promise<Record<string, unknown>> => {
    const result = await tool.execute(args as never, { agent: caller as never, signal: new AbortController().signal } as never)
    return result as Record<string, unknown>
  }

  return { dir, workspaceDir: wsDir, state, followupTexts, run }
}

function seedPendingPlan(rt: Runtime, planId: string): void {
  savePlan(rt.workspaceDir, planId, {
    plan_id: planId,
    module_name: 'mod-x',
    development_plan: 'dev',
    session_id: 'ses-limu-x',
    modified_files: [],
  }, 'summary', CALLER)
  markPlanComplete(rt.workspaceDir, planId, [])
}

describe('recoverAgentMode 三级链（经 handlePing 观测）', () => {
  it('第一级：内存 descriptor continuable + persona marker 命中，优先于文件兜底', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l1', inMemory: { mode: 'limu' }, persisted: 'fengzhou' })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l1' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l1')).toBe('limu')
      expect(res.message).toBe('已向力牧会话 ses-l1 发送提醒并标记二次检查。')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('第一级：内存 descriptor 按 inheritedEventCount 截断 seed 前缀后识别', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l1-seed', inMemory: { mode: 'kui', inheritedEventCount: 2 } })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l1-seed' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l1-seed')).toBe('kui')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('第二级：内存无 agent，冷会话 handle.read 返回 { eventState, events } 并按 inheritedEventCount 截断识别', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l2', cold: descriptorEvents('gaotao', 1) })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l2' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l2')).toBe('gaotao')
      expect(res.message).toBe('已向皋陶会话 ses-l2 发送提醒。')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('第二级 descriptor 为 one-shot（非 continuable）→ 落到文件兜底框架模式', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l2-one', cold: oneShotEvents(), persisted: 'lizhu' })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l2-one' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l2-one')).toBe('lizhu')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('第二级 open 抛错（会话损坏/缺失）不抛出 → 落到文件兜底框架模式', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l2-throw', cold: 'throw', persisted: 'gaotao' })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l2-throw' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l2-throw')).toBe('gaotao')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('第一级内存 descriptor continuable 但 persona 无 marker → 落到文件兜底框架模式', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l1-nomark', inMemory: { mode: undefined }, persisted: 'kui' })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l1-nomark' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l1-nomark')).toBe('kui')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('第一级内存 descriptor 为 one-shot → 落到文件兜底框架模式', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-l1-one', inMemory: 'one-shot', persisted: 'limu' })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-l1-one' })
      expect(res.status).toBe('ok')
      expect(rt.state.getAgentMode('ses-l1-one')).toBe('limu')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('文件兜底：四种框架子代理模式均可用', async () => {
    for (const mode of ['limu', 'gaotao', 'lizhu', 'kui'] as const) {
      const sid = `ses-fb-${mode}`
      const rt = await makeRuntime({ sessionId: sid, persisted: mode })
      try {
        const res = await rt.run({ action: 'ping', session_id: sid })
        expect(res.status).toBe('ok')
        expect(rt.state.getAgentMode(sid)).toBe(mode)
      } finally {
        await rm(rt.dir, { recursive: true, force: true })
      }
    }
  })

  it('文件兜底：宿主模式（fengzhou/qibo/lishou）不识别 → error', async () => {
    for (const mode of ['fengzhou', 'qibo', 'lishou'] as const) {
      const sid = `ses-host-${mode}`
      const rt = await makeRuntime({ sessionId: sid, persisted: mode })
      try {
        const res = await rt.run({ action: 'ping', session_id: sid })
        expect(res.status).toBe('error')
        expect(res.error).toBe(`会话 ${sid} 的角色无法识别，请确认会话状态后再 ping。`)
        expect(rt.state.getAgentMode(sid)).toBeUndefined()
      } finally {
        await rm(rt.dir, { recursive: true, force: true })
      }
    }
  })

  it('三级均未命中 → error', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-none' })
    try {
      const res = await rt.run({ action: 'ping', session_id: 'ses-none' })
      expect(res.status).toBe('error')
      expect(res.error).toBe('会话 ses-none 的角色无法识别，请确认会话状态后再 ping。')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })
})

describe('handlePing 恢复后 setAgentMode + persistMode', () => {
  it('内存路径恢复后写入 session_modes.json', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-p1', inMemory: { mode: 'lizhu' } })
    try {
      expect(rt.state.getAgentMode('ses-p1')).toBeUndefined()
      await rt.run({ action: 'ping', session_id: 'ses-p1' })
      expect(rt.state.getAgentMode('ses-p1')).toBe('lizhu')
      expect(restoreMode(rt.dir)['ses-p1']).toBe('lizhu')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('冷会话路径恢复后写入 session_modes.json', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-p2', cold: descriptorEvents('kui') })
    try {
      await rt.run({ action: 'ping', session_id: 'ses-p2' })
      expect(rt.state.getAgentMode('ses-p2')).toBe('kui')
      expect(restoreMode(rt.dir)['ses-p2']).toBe('kui')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('文件兜底路径恢复后同样写入 session_modes.json（幂等）', async () => {
    const rt = await makeRuntime({ sessionId: 'ses-p3', cold: 'throw', persisted: 'gaotao' })
    try {
      await rt.run({ action: 'ping', session_id: 'ses-p3' })
      expect(rt.state.getAgentMode('ses-p3')).toBe('gaotao')
      expect(restoreMode(rt.dir)['ses-p3']).toBe('gaotao')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })
})

describe('isValidReusableSession 经 recoverAgentMode（文件兜底）', () => {
  it('夔：内存无 mode、文件兜底 kui → 复用成功、补设 mode 并持久化', async () => {
    const rt = await makeRuntime({
      sessionId: 'ses-reuse-kui',
      bindings: { kui: { [CALLER]: 'ses-reuse-kui' } },
      seedWorkspaces: { 'ses-reuse-kui': WS },
      persisted: 'kui',
    })
    try {
      expect(rt.state.getAgentMode('ses-reuse-kui')).toBeUndefined()
      const res = await rt.run({ action: 'start_kui', plans: [{ module_name: 'mod-x', development_plan: 'plan-a' }] })
      expect(res.reused).toBe(true)
      expect(res.kui_session_id).toBe('ses-reuse-kui')
      expect(rt.state.getAgentMode('ses-reuse-kui')).toBe('kui')
      expect(restoreMode(rt.dir)['ses-reuse-kui']).toBe('kui')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('皋陶：内存无 mode、文件兜底 gaotao → 复用成功', async () => {
    const rt = await makeRuntime({
      sessionId: 'ses-reuse-gaotao',
      bindings: { gaotao: { [CALLER]: 'ses-reuse-gaotao' } },
      seedWorkspaces: { 'ses-reuse-gaotao': WS },
      persisted: 'gaotao',
    })
    try {
      seedPendingPlan(rt, 'plan-gt-reuse')
      const res = await rt.run({ action: 'start_review' })
      expect(res.reused).toBe(true)
      expect(res.reviewer_session_id).toBe('ses-reuse-gaotao')
      expect(rt.state.getAgentMode('ses-reuse-gaotao')).toBe('gaotao')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('离朱：内存无 mode、文件兜底 lizhu → 复用成功', async () => {
    const rt = await makeRuntime({
      sessionId: 'ses-reuse-lizhu',
      lizhuSessions: ['ses-reuse-lizhu'],
      children: ['ses-reuse-lizhu'],
      seedWorkspaces: { 'ses-reuse-lizhu': WS },
      persisted: 'lizhu',
    })
    try {
      const res = await rt.run({ action: 'start_lizhu' })
      expect(res.reused).toBe(true)
      expect(res.lizhu_session_id).toBe('ses-reuse-lizhu')
      expect(rt.state.getAgentMode('ses-reuse-lizhu')).toBe('lizhu')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('文件兜底为宿主模式 → 角色不符、不复用（清绑定）', async () => {
    const rt = await makeRuntime({
      sessionId: 'ses-reuse-host',
      bindings: { kui: { [CALLER]: 'ses-reuse-host' } },
      seedWorkspaces: { 'ses-reuse-host': WS },
      persisted: 'fengzhou',
    })
    try {
      const res = await rt.run({ action: 'start_kui', plans: [{ module_name: 'mod-x', development_plan: 'plan-a' }] })
      expect(res.status).toBe('error')
      expect(res.reused).toBeUndefined()
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })

  it('力牧 start 复用：文件兜底 limu → 复用成功', async () => {
    const rt = await makeRuntime({
      sessionId: 'ses-reuse-limu',
      modules: ['mod-x'],
      moduleSessions: { 'mod-x': ['ses-reuse-limu'] },
      persisted: 'limu',
    })
    try {
      await verificationCode.execute({}, { agent: { id: CALLER } } as never)
      const code = getLatestCode(CALLER)!
      storePlanConfirmation('plan-limu-reuse', code)
      const res = await rt.run({
        action: 'start',
        module_name: 'mod-x',
        development_plan: 'dev',
        plan_id: 'plan-limu-reuse',
        plan_summary: 'summary',
      })
      expect(res.session_id).toBe('ses-reuse-limu')
      expect(res.reused).toBe(true)
      expect(rt.state.getAgentMode('ses-reuse-limu')).toBe('limu')
      expect(restoreMode(rt.dir)['ses-reuse-limu']).toBe('limu')
    } finally {
      await rm(rt.dir, { recursive: true, force: true })
    }
  })
})
